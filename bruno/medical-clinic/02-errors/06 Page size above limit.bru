meta {
  name: Page size above limit (400)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/visits?size=500
  body: none
  auth: none
}

params:query {
  size: 500
}

tests {
  test("400 instead of silently returning 100 rows", function() {
    expect(res.status).to.equal(400);
    expect(res.body.errors[0].field).to.equal("size");
  });
}

