meta {
  name: OpenAPI specification
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v3/api-docs
  body: none
  auth: none
}

docs {
  Specyfikację można zaimportować w Bruno (Import Collection -> OpenAPI) do OSOBNEJ, pomocniczej
  kolekcji. Import daje listę żądań z przykładowymi danymi, ale nie zastępuje scenariusza
  z folderu 01-scenario: nie przenosi ID między krokami ani nie sprawdza oczekiwanych statusów.
}

tests {
  test("spec describes ApiError", function() {
    expect(res.status).to.equal(200);
    expect(res.body.components.schemas.ApiError).to.not.equal(undefined);
  });
}

