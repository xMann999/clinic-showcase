meta {
  name: Read patient from Location
  type: http
  seq: 3
}

get {
  url: {{patientLocation}}
  body: none
  auth: none
}

tests {
  test("resource from Location is readable", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("patientId"));
  });
}

